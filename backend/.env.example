# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Postgres
DATABASE_URL=postgres://narrator:narrator@localhost:5432/narrator

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2

# Auth (email/password)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Auth (Google OAuth) - leave blank to disable the "Continue with Google" button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=narrator-videos

# Stripe (prices in INR — ₹500 Starter, ₹1,500 Pro; Enterprise is sales-assisted)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx

# Avatar/TTS/lip-sync provider (pluggable - HeyGen/D-ID/ElevenLabs style API).
# Leave blank to fall back to bundled local stub assets for development.
AVATAR_PROVIDER_API_KEY=
AVATAR_PROVIDER_BASE_URL=
